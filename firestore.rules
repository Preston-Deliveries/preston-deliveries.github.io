rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() in ['jozza721@gmail.com', 'jozza21@gmail.com'];
    }
    function accessPath() {
      return /databases/$(database)/documents/access/$(myEmail());
    }
    function hasAccess() {
      return signedIn() && exists(accessPath());
    }
    function isAdmin() {
      return isOwner() || (hasAccess() && get(accessPath()).data.role == 'admin');
    }
    function isMember() {
      return isAdmin() || hasAccess();
    }
    // Only admins can see these. Everything else can be read by anyone on the team list.
    function adminOnly(col) {
      return col in ['staff', 'weeks', 'precards', 'lockers', 'leave', 'leavecfg',
        'dircfg', 'ntdrafts', 'uniorders', 'enquiries', 'enqimg', 'enqcfg', 'enqpending',
        'enqlog', 'compliance', 'vchecks', 'timesheets', 'settings', 'access', 'meta', 'clock', 'briefsigs', 'feedback', 'reports', 'reportimg', 'invcfg', 'invlog', 'invme', 'leavereq', 'tlcheck'];
    }

    function myStaff() {
      return get(accessPath()).data.staff;
    }
    // Clock in and out: drivers add their own times only. Tapped times must be Google's server time.
    match /clock/{id} {
      allow read: if isAdmin() || (hasAccess() && (resource == null || resource.data.staff == myStaff()));
      allow create: if isAdmin() || (hasAccess()
        && request.resource.data.staff == myStaff()
        && id == request.resource.data.date + '_' + myStaff()
        && request.resource.data.keys().hasOnly(['staff', 'name', 'date', 'start', 'startAt', 'startLate', 'startEdited', 'finish', 'finishAt', 'finishLate', 'brk', 'held', 'heldCount', 'extra', 'twoLoads', 'updatedAt'])
        && (request.resource.data.startLate == true || request.resource.data.startAt == request.time));
      allow update: if isAdmin() || (hasAccess()
        && resource.data.staff == myStaff()
        && request.resource.data.staff == myStaff()
        && ((!('finish' in resource.data)
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['start', 'startEdited', 'updatedAt'])
               && request.resource.data.startEdited == true)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finish', 'finishAt', 'finishLate', 'brk', 'held', 'heldCount', 'extra', 'twoLoads', 'updatedAt'])
               && (request.resource.data.finishLate == true || request.resource.data.finishAt == request.time))))
        // tapped Finish by mistake: take the finish off again and carry on the shift
        || (('finish' in resource.data) && !('finish' in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finish', 'finishAt', 'finishLate', 'brk', 'held', 'heldCount', 'extra', 'twoLoads', 'updatedAt']))));
      // tapped Start by mistake: drivers can remove their own entry while the shift is still open
      allow delete: if isAdmin() || (hasAccess() && resource.data.staff == myStaff() && !('finish' in resource.data));
    }
    // Team brief sign off: each person signs once for themselves; only admins change or remove
    match /briefsigs/{id} {
      allow read: if isAdmin() || (hasAccess() && (resource == null || resource.data.staff == myStaff()));
      allow create: if isAdmin() || (hasAccess()
        && request.resource.data.staff == myStaff()
        && id == request.resource.data.brief + '_' + myStaff()
        && request.resource.data.keys().hasOnly(['brief', 'staff', 'name', 'agreed', 'sig', 'signedAt'])
        && request.resource.data.signedAt == request.time
        && request.resource.data.sig is string && request.resource.data.sig.size() < 300000);
      allow update, delete: if isAdmin();
    }
    // Feedback: anyone on the team can send a message for themselves; only admins can read, change or delete
    match /feedback/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (hasAccess()
        && request.resource.data.staff == myStaff()
        && request.resource.data.keys().hasOnly(['staff', 'name', 'topic', 'text', 'followUp', 'status', 'at'])
        && request.resource.data.status == 'new'
        && request.resource.data.at == request.time
        && request.resource.data.text is string && request.resource.data.text.size() <= 4000);
    }
    // Incident, vehicle accident and safety hazard reports: anyone on the team can send their own; only admins can read, change or delete
    match /reports/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (hasAccess()
        && request.resource.data.staff == myStaff()
        && request.resource.data.keys().hasOnly(['kind', 'staff', 'name', 'run', 'f', 'photos', 'serious', 'status', 'at'])
        && request.resource.data.kind in ['incident', 'vehicle', 'hazard']
        && request.resource.data.status == 'new'
        && request.resource.data.at == request.time);
    }
    match /reportimg/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (hasAccess()
        && request.resource.data.staff == myStaff()
        && request.resource.data.keys().hasOnly(['staff', 'img', 'at'])
        && request.resource.data.at == request.time
        && request.resource.data.img is string && request.resource.data.img.size() < 900000);
    }
    // Driver invoices. Each driver can read only their own records; the office sets rates; drivers enter their own ABN and bank details
    match /timesheets/{id} {
      allow read: if isAdmin() || (hasAccess() && id.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_' + myStaff()));
      allow write: if isAdmin();
    }
    match /invcfg/{id} {
      allow read: if isAdmin() || (hasAccess() && id == myStaff());
      allow write: if isAdmin();
    }
    match /invme/{id} {
      allow read: if isAdmin() || (hasAccess() && id == myStaff());
      allow write: if isAdmin() || (hasAccess() && id == myStaff()
        && request.resource.data.keys().hasOnly(['abn', 'address', 'phone', 'email', 'acct', 'bsb', 'acctNo', 'gst', 'at']));
    }
    match /invlog/{id} {
      allow read: if isAdmin() || (hasAccess() && resource.data.sid == myStaff());
      allow create: if isAdmin() || (hasAccess()
        && request.resource.data.sid == myStaff()
        && id == myStaff() + '_' + request.resource.data.from
        && request.resource.data.status == 'submitted');
      allow update: if isAdmin() || (hasAccess()
        && resource.data.sid == myStaff() && resource.data.status == 'submitted'
        && request.resource.data.sid == myStaff()
        && request.resource.data.status == 'submitted');
      allow delete: if isAdmin();
    }
    // Uniform orders: a driver sends their own order into the app; only admins see everyone's, change or delete
    match /uniorders/{id} {
      allow read: if isAdmin() || (hasAccess() && resource.data.staff == myStaff());
      allow create: if isAdmin() || (hasAccess()
        && request.resource.data.staff == myStaff()
        && request.resource.data.keys().hasOnly(['staff', 'name', 'items', 'status', 'requestedAt'])
        && request.resource.data.status == 'requested'
        && request.resource.data.items is list && request.resource.data.items.size() <= 20);
      allow update, delete: if isAdmin();
    }
    // Leave requests: drivers ask for their own time off and can cancel it while it is waiting; only admins approve or decline
    match /leavereq/{id} {
      allow read: if isAdmin() || (hasAccess() && resource.data.staff == myStaff());
      allow create: if isAdmin() || (hasAccess()
        && request.resource.data.staff == myStaff()
        && request.resource.data.keys().hasOnly(['staff', 'name', 'from', 'to', 'days', 'note', 'cover', 'long', 'status', 'at'])
        && request.resource.data.status == 'pending'
        && request.resource.data.at == request.time);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (hasAccess() && resource.data.staff == myStaff() && resource.data.status == 'pending');
    }
    match /access/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow write: if isAdmin();
    }

    match /{col}/{docId} {
      allow read: if isAdmin() || (isMember() && !adminOnly(col));
      allow write: if isAdmin();
    }
  }
}

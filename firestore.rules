rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() in ['jozza721@gmail.com', 'jozza21@gmail.com'];
    }
    function accessPath() {
      return /databases/$(database)/documents/access/$(myEmail());
    }
    function hasAccess() {
      return signedIn() && exists(accessPath());
    }
    function isAdmin() {
      return isOwner() || (hasAccess() && get(accessPath()).data.role == 'admin');
    }
    function isMember() {
      return isAdmin() || hasAccess();
    }
    // Only admins can see these. Everything else can be read by anyone on the team list.
    function adminOnly(col) {
      return col in ['staff', 'days', 'weeks', 'precards', 'lockers', 'leave', 'leavecfg',
        'dircfg', 'ntdrafts', 'uniorders', 'enquiries', 'enqimg', 'enqcfg', 'enqpending',
        'enqlog', 'compliance', 'vchecks', 'timesheets', 'settings', 'access', 'meta', 'clock', 'briefsigs'];
    }

    function myStaff() {
      return get(accessPath()).data.staff;
    }
    // Clock in and out: drivers add their own times only. Tapped times must be Google's server time.
    match /clock/{id} {
      allow read: if isAdmin() || (hasAccess() && (resource == null || resource.data.staff == myStaff()));
      allow create: if isAdmin() || (hasAccess()
        && request.resource.data.staff == myStaff()
        && id == request.resource.data.date + '_' + myStaff()
        && request.resource.data.keys().hasOnly(['staff', 'name', 'date', 'start', 'startAt', 'startLate', 'startEdited', 'finish', 'finishAt', 'finishLate', 'brk', 'held', 'heldCount', 'extra', 'twoLoads', 'updatedAt'])
        && (request.resource.data.startLate == true || request.resource.data.startAt == request.time));
      allow update: if isAdmin() || (hasAccess()
        && resource.data.staff == myStaff()
        && !('finish' in resource.data)
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['start', 'startEdited', 'updatedAt'])
             && request.resource.data.startEdited == true)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finish', 'finishAt', 'finishLate', 'brk', 'held', 'heldCount', 'extra', 'twoLoads', 'updatedAt'])
             && (request.resource.data.finishLate == true || request.resource.data.finishAt == request.time))));
      allow delete: if isAdmin();
    }
    // Team brief sign off: each person signs once for themselves; only admins change or remove
    match /briefsigs/{id} {
      allow read: if isAdmin() || (hasAccess() && (resource == null || resource.data.staff == myStaff()));
      allow create: if isAdmin() || (hasAccess()
        && request.resource.data.staff == myStaff()
        && id == request.resource.data.brief + '_' + myStaff()
        && request.resource.data.keys().hasOnly(['brief', 'staff', 'name', 'agreed', 'sig', 'signedAt'])
        && request.resource.data.signedAt == request.time
        && request.resource.data.sig is string && request.resource.data.sig.size() < 300000);
      allow update, delete: if isAdmin();
    }
    match /access/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow write: if isAdmin();
    }

    match /{col}/{docId} {
      allow read: if isAdmin() || (isMember() && !adminOnly(col));
      allow write: if isAdmin();
    }
  }
}
